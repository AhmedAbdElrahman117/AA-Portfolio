---
import "../styles/global.css";

// Normalize BASE_URL to always end with '/'
const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + "/";

interface Props {
    title?: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
}

const {
    title = "Ahmed Abdelrahman - Flutter Developer Portfolio",
    description = "Ahmed Abdelrahman — Flutter & Mobile Developer. Building high-performance, cross-platform mobile applications with elegant UIs.",
    canonicalUrl = "https://ahmed-abdelrahman.web.app",
    ogImage = `${base}icons/portfolio.png`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#000000" />

        <!-- SEO Core -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Ahmed Abdelrahman" />
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <meta name="keywords" content="Flutter Developer, Mobile App Developer, Ahmed Abdelrahman, Portfolio, Cross-Platform, Dart, Firebase, iOS, Android" />
        <link rel="canonical" href={canonicalUrl} />
        <meta
            name="google-site-verification"
            content="8wZ2qjI_b8d3H6D2_F6I8p2_Z1E91_T1M0m1-U1W6J8"
        />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:site_name" content="AA Portfolio" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Favicon -->
        <link rel="icon" type="image/png" href={`${base}icons/portfolio.png`} />
        <link rel="apple-touch-icon" href={`${base}icons/portfolio.png`} />

        <!-- PWA Manifest -->
        <link rel="manifest" href={`${base}manifest.json`} />

        <!-- Resource Hints — eliminate connection latency for critical origins -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
        <link rel="dns-prefetch" href="https://unpkg.com" />
        <link
            rel="dns-prefetch"
            href="https://firebasestorage.googleapis.com"
        />

        <!--
            PERF: Google Fonts — non-render-blocking preload swap.
            The browser downloads the CSS file at high priority but doesn't
            block first paint. The onload handler swaps it to a real stylesheet.
        -->
        <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <!--
            PERF: Font Awesome — non-render-blocking preload swap.
            Saves ~200ms of render-blocking time on initial load.
        -->
        <link
            rel="preload"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            />
        </noscript>

        <!-- PERF: Force font-display:swap on Font Awesome webfonts to prevent FOIT -->
        <style>
            @font-face {
                font-family: "Font Awesome 6 Free";
                font-display: swap;
            }
            @font-face {
                font-family: "Font Awesome 6 Brands";
                font-display: swap;
            }
            @font-face {
                font-family: "fa-solid-900";
                font-display: swap;
            }
            @font-face {
                font-family: "fa-brands-400";
                font-display: swap;
            }
        </style>

        <!-- PERF: Lottie — pinned version for CDN cache, defer + crossorigin -->
        <script
            src="https://unpkg.com/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js"
            defer
            crossorigin="anonymous"></script>

        <!-- JSON-LD Structured Data — rich search results -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Ahmed Abdelrahman",
                url: canonicalUrl,
                image: ogImage,
                jobTitle: "Flutter Developer",
                description: description,
                sameAs: [
                    "https://www.linkedin.com/in/ahmed-abo-el-naga-b200892a5/",
                    "https://github.com/AhmedAbdElrahman117",
                    "https://www.facebook.com/lorr.ahmed.37/",
                    "https://www.upwork.com/freelancers/~0128038751f7bbffdf"
                ],
            })}
        />
    </head>
    <body class="bg-primary text-text-primary overflow-x-hidden min-h-screen">
        <a href="#home" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[99999] focus:bg-brand-light focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-medium focus:shadow-lg">Skip to content</a>
        <slot />

        <!-- Global Full-Screen Image Preview Modal -->
        <div
            id="image-preview-modal"
            class="fixed inset-0 z-[99999] bg-black/95 backdrop-blur-md flex items-center justify-center p-4 opacity-0 invisible transition-all duration-300"
            role="dialog"
            aria-modal="true"
            aria-label="Image preview"
        >
            <button
                id="close-preview-modal"
                class="absolute top-4 right-4 w-12 h-12 bg-black/50 hover:bg-red-500 text-white rounded-full flex items-center justify-center transition-all duration-300 z-10 border border-white/20 hover:scale-110 shadow-lg"
                aria-label="Close image preview"
            >
                <i class="fas fa-times text-xl" aria-hidden="true"></i>
            </button>
            <div
                class="w-full h-full flex items-center justify-center pointer-events-none"
            >
                <img
                    id="image-preview-content"
                    alt="Full screen preview"
                    width="800"
                    height="600"
                    class="max-w-full max-h-full object-contain pointer-events-auto rounded-lg shadow-2xl border border-white/10"
                />
            </div>
        </div>
    </body>
</html>

---
// AnimatedBackground.astro
---
<div class="fixed inset-0 w-full h-full -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(33,150,243,0.15),transparent_50%),radial-gradient(ellipse_at_bottom_left,rgba(103,58,183,0.15),transparent_50%)] overflow-hidden">
    <div class="absolute inset-0 bg-primary/80 backdrop-blur-[2px]"></div>
    <div class="absolute w-[300px] h-[300px] rounded-full bg-brand-light/10 blur-[60px] top-[10%] left-[10%] animate-float"></div>
    <div class="absolute w-[200px] h-[200px] rounded-full bg-brand-dark/10 blur-[50px] top-[20%] right-[15%] animate-float" style="animation-delay: -2s;"></div>
    <div class="absolute w-[250px] h-[250px] rounded-full bg-brand-accent/10 blur-[60px] bottom-[20%] left-[20%] animate-float" style="animation-delay: -4s;"></div>
    <div class="absolute w-[150px] h-[150px] rounded-full bg-brand-light/10 blur-[40px] bottom-[10%] right-[10%] animate-float" style="animation-delay: -1s;"></div>
</div>

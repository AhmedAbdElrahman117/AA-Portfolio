---
// Navbar.astro
---
<nav class="fixed top-0 left-0 w-full h-[70px] bg-primary/90 backdrop-blur-[10px] z-[1000] border-b border-border transition-all duration-300 transform translate-y-0" id="navbar">
    <div class="max-w-container w-full h-full mx-auto px-lg flex items-center justify-between">
        <!-- Logo -->
        <a href="#home" class="text-2xl font-bold flex items-center gap-xs">
            <span class="gradient-text">A</span>
            <span class="text-text-primary">A</span>
        </a>

        <!-- Desktop Navigation -->
        <ul class="flex gap-md h-full items-center m-0 max-md:hidden">
            <li class="h-full flex items-center"><a href="#home" class="nav-link active" data-section="home">Home</a></li>
            <li class="h-full flex items-center"><a href="#about" class="nav-link" data-section="about">About</a></li>
            <li class="h-full flex items-center"><a href="#skills" class="nav-link" data-section="skills">Skills</a></li>
            <li class="h-full flex items-center"><a href="#services" class="nav-link" data-section="services">Services</a></li>
            <li class="h-full flex items-center"><a href="#portfolio" class="nav-link" data-section="portfolio">Portfolio</a></li>
            <li class="h-full flex items-center"><a href="#contact" class="nav-link" data-section="contact">Contact</a></li>
        </ul>

        <!-- Mobile Menu Button -->
        <button class="hidden flex-col gap-[5px] bg-none border-none cursor-pointer p-sm max-md:flex" id="hamburger" aria-label="Toggle menu">
            <span class="block w-[25px] h-[3px] bg-gradient-to-r from-brand-light to-brand-dark rounded-sm transition-all duration-300"></span>
            <span class="block w-[25px] h-[3px] bg-gradient-to-r from-brand-light to-brand-dark rounded-sm transition-all duration-300"></span>
            <span class="block w-[25px] h-[3px] bg-gradient-to-r from-brand-light to-brand-dark rounded-sm transition-all duration-300"></span>
        </button>
    </div>
</nav>

<!-- Mobile Drawer -->
<div class="fixed top-0 left-0 w-[300px] h-[100dvh] bg-primary/95 backdrop-blur-[15px] z-[1001] -translate-x-[110%] transition-transform duration-300 shadow-[5px_0_25px_rgba(0,0,0,0.5)] border-r border-border max-w-full" id="drawer">
    <div class="h-full flex flex-col p-lg overflow-y-auto">
        <div class="flex items-center justify-between mb-xl pb-md border-b border-border">
            <span class="text-xl font-semibold gradient-text">Menu</span>
            <button class="bg-none border-none text-text-primary text-xl cursor-pointer p-sm transition-colors duration-300 hover:text-brand-accent hover:rotate-90" id="closeDrawer" aria-label="Close menu">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <div class="flex flex-col gap-2">
            <a href="#home" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link active" data-section="home"><i class="fas fa-home w-5 text-center text-brand-light"></i> Home</a>
            <a href="#about" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link" data-section="about"><i class="fas fa-user w-5 text-center text-brand-light"></i> About</a>
            <a href="#skills" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link" data-section="skills"><i class="fas fa-code w-5 text-center text-brand-light"></i> Skills</a>
            <a href="#services" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link" data-section="services"><i class="fas fa-concierge-bell w-5 text-center text-brand-light"></i> Services</a>
            <a href="#portfolio" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link" data-section="portfolio"><i class="fas fa-briefcase w-5 text-center text-brand-light"></i> Portfolio</a>
            <a href="#contact" class="flex items-center gap-3 py-4 px-4 rounded-lg text-text-primary text-base font-medium transition-all duration-300 hover:bg-white/5 hover:text-brand-light drawer-link" data-section="contact"><i class="fas fa-envelope w-5 text-center text-brand-light"></i> Contact</a>
        </div>
    </div>
</div>
<div class="fixed inset-0 bg-black/60 z-[1000] opacity-0 invisible transition-all duration-300 backdrop-blur-[3px]" id="drawerOverlay"></div>

<script>
    // Navigation functionality matching main.js
    const hamburger = document.getElementById('hamburger');
    const drawer = document.getElementById('drawer');
    const closeDrawerBtn = document.getElementById('closeDrawer');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const drawerLinks = document.querySelectorAll('.drawer-link');
    const navLinksDesktop = document.querySelectorAll('.nav-link');
    const navbar = document.getElementById('navbar');

    function openDrawer() {
        drawer.classList.remove('-translate-x-[110%]');
        drawer.classList.add('translate-x-0');
        drawerOverlay.style.opacity = '1';
        drawerOverlay.style.visibility = 'visible';
        document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('-translate-x-[110%]');
        drawerOverlay.style.opacity = '0';
        drawerOverlay.style.visibility = 'hidden';
        document.body.style.overflow = '';
    }

    if (hamburger && drawer && closeDrawerBtn && drawerOverlay) {
        hamburger.addEventListener('click', openDrawer);
        closeDrawerBtn.addEventListener('click', closeDrawer);
        drawerOverlay.addEventListener('click', closeDrawer);

        drawerLinks.forEach(link => {
            link.addEventListener('click', closeDrawer);
        });
    }

    // Update active nav based on scroll
    function updateActiveNav(sectionId) {
        const desktopLinks = document.querySelectorAll('.nav-link');
        const drawerLinks = document.querySelectorAll('.drawer-link');
        
        [...desktopLinks, ...drawerLinks].forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('data-section') === sectionId) {
                link.classList.add('active');
            }
        });
    }

    let isScrolling = false;
    let scrollTimeout;

    // Scroll spy math using the original debounced implementation
    let debounceTimer;
    function debounce(func, wait) {
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(debounceTimer);
                func(...args);
            };
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(later, wait);
        };
    }

    let isScrollingFromClick = false;
    let clickScrollTimeout;
    let animationFrameId = null;
    let lastSection = null;

    const updateSectionOnScrollStop = debounce(() => {
        if (animationFrameId || isScrollingFromClick) return;

        animationFrameId = requestAnimationFrame(() => {
            const sections = document.querySelectorAll('section');
            const cachedNavHeight = 70;
            // The magic formula from original main.js: check the top third of the screen
            const scrollPosition = window.scrollY + cachedNavHeight + window.innerHeight / 3;

            // Batch all layout reads
            const sectionData = Array.from(sections).map(section => ({
                id: section.getAttribute('id'),
                top: section.offsetTop,
                height: section.offsetHeight
            }));

            // Find current section
            let currentSection = null;
            for (const data of sectionData) {
                if (scrollPosition >= data.top && scrollPosition < data.top + data.height) {
                    currentSection = data.id;
                    break;
                }
            }

            if (currentSection && currentSection !== lastSection) {
                lastSection = currentSection;
                updateActiveNav(currentSection);
            }

            animationFrameId = null;
        });
    }, 80); // Debounce time from original code

    window.addEventListener('scroll', updateSectionOnScrollStop, { passive: true });

    // Navbar blur on scroll (Lightweight)
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar.classList.add('shadow-lg');
            navbar.style.backgroundColor = 'rgba(0, 0, 0, 0.95)';
        } else {
            navbar.classList.remove('shadow-lg');
            navbar.style.backgroundColor = 'rgba(0, 0, 0, 0.9)';
        }
    }, { passive: true });

    // Handle smooth scroll clicks matching original logic
    [...navLinksDesktop, ...drawerLinks].forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('href');
            if (targetId && targetId !== '#') {
                const section = document.querySelector(targetId);
                if (section) {
                    // Instantly lock UI state for this click
                    isScrollingFromClick = true;
                    updateActiveNav(targetId.substring(1));
                    lastSection = targetId.substring(1);

                    requestAnimationFrame(() => {
                        const sectionTop = section.offsetTop - 70; // Hardcoded nav height matches original
                        window.scrollTo({
                            top: sectionTop,
                            behavior: 'smooth'
                        });
                    });

                    // Resume scroll spy after max possible smooth scroll duration
                    clearTimeout(clickScrollTimeout);
                    clickScrollTimeout = setTimeout(() => {
                        isScrollingFromClick = false;
                    }, 1000);
                }
            }
        });
    });
</script>

<style>
    /* Reproducing original exact CSS from styles.css */
    .nav-link {
        position: relative;
        font-size: 16px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        padding: 8px 16px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border-radius: 8px;
        transform: translateZ(0);
        will-change: color, transform;
    }

    .nav-link::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(33, 150, 243, 0.1), rgba(103, 58, 183, 0.1));
        border-radius: 8px;
        opacity: 0;
        transform: scale(0.8);
        transition: all 0.3s ease;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 50%;
        transform: translateX(-50%) scaleX(0);
        width: 30px;
        height: 3px;
        background: linear-gradient(90deg, var(--color-brand-light), var(--color-brand-dark));
        border-radius: 8px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 0 10px rgba(33, 150, 243, 0.5);
    }

    .nav-link:hover {
        color: #ffffff;
    }

    .nav-link:hover::before {
        opacity: 1;
        transform: scale(1);
    }

    .nav-link:hover::after {
        transform: translateX(-50%) scaleX(0.5);
    }

    .nav-link.active {
        color: #ffffff;
    }

    .nav-link.active::before {
        opacity: 1;
        transform: scale(1);
        background: linear-gradient(135deg, rgba(33, 150, 243, 0.2), rgba(103, 58, 183, 0.2));
    }

    .nav-link.active::after {
        transform: translateX(-50%) scaleX(1);
        width: 40px;
        animation: navGlow 2s ease-in-out infinite;
    }

    @keyframes navGlow {
        0%, 100% {
            box-shadow: 0 0 10px rgba(33, 150, 243, 0.5);
            opacity: 1;
        }
        50% {
            box-shadow: 0 0 20px rgba(33, 150, 243, 0.8), 0 0 30px rgba(103, 58, 183, 0.5);
            opacity: 0.8;
        }
    }
    
    .drawer-link.active {
        background: linear-gradient(90deg, var(--color-brand-light), var(--color-brand-dark));
        color: #ffffff;
    }

    .drawer-link.active i {
        color: #ffffff;
    }
</style>

---
// Certificates.astro
import SectionHeader from '../common/SectionHeader.astro';
---
<section id="certificates" class="py-section relative bg-gradient-to-b from-black/30 to-transparent">
    <div class="max-w-container mx-auto px-lg">
        <SectionHeader title="Certificates" />

        <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-lg" id="certificates-grid">
            <!-- Certificates Injected Here -->
        </div>
    </div>
</section>

<!-- Full Image Viewer Modal (Shared/Standalone) -->
<div id="image-viewer" class="fixed inset-0 z-[1200] bg-black/95 flex items-center justify-center opacity-0 invisible transition-all duration-300 backdrop-blur-sm cursor-zoom-out">
    <button id="close-image-viewer" class="absolute top-6 right-6 w-12 h-12 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-colors border border-white/20 text-xl z-10 cursor-pointer">
        <i class="fas fa-times"></i>
    </button>
    <img id="viewer-image" src="" alt="Full View" class="max-w-[90vw] max-h-[90vh] object-contain scale-95 transition-transform duration-300">
</div>

<script>
    import { getPortfolioData } from '../../lib/firebase';

    async function loadCertificates() {
        const data = await getPortfolioData();
        const grid = document.getElementById('certificates-grid');
        
        if(!grid || !data || !data.certificates) return;
        grid.innerHTML = '';
        
        data.certificates.forEach((cert, i) => {
            const delay = (i % 4) * 0.1;
            const imgSrc = cert.image.startsWith('http') ? cert.image : `/${cert.image}`;

            const card = document.createElement('div');
            card.className = `glass-effect rounded-xl overflow-hidden group cursor-zoom-in hover:-translate-y-2 hover:shadow-glow hover:border-brand-light transition-all duration-300 opacity-0 translate-y-8 animate-cert-card`;
            card.style.animationDelay = `${delay}s`;
            card.innerHTML = `
                <div class="relative aspect-[4/3] overflow-hidden">
                    <img src="${imgSrc}" alt="${cert.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
                    <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                        <div class="w-12 h-12 rounded-full bg-brand-light/90 text-white flex items-center justify-center text-xl transform scale-0 group-hover:scale-100 transition-transform duration-300 -mt-8">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>
                </div>
                <div class="p-md text-center border-t border-border bg-gradient-to-t from-black/50 to-transparent">
                    <h3 class="text-text-primary font-medium text-base truncate" title="${cert.title}">${cert.title}</h3>
                </div>
            `;
            
            card.addEventListener('click', () => openImageViewer(imgSrc));
            grid.appendChild(card);
        });

        setupCertAnimations();
    }

    function setupCertAnimations() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.remove('opacity-0', 'translate-y-8');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-cert-card').forEach(card => observer.observe(card));
    }

    // Image Viewer Logic
    const viewer = document.getElementById('image-viewer');
    const viewerImg = document.getElementById('viewer-image');
    const closeViewerBtn = document.getElementById('close-image-viewer');

    function openImageViewer(src) {
        if(!viewer || !viewerImg) return;
        viewerImg.setAttribute('src', src);
        viewer.classList.remove('opacity-0', 'invisible');
        setTimeout(() => {
            viewerImg.classList.remove('scale-95');
            viewerImg.classList.add('scale-100');
        }, 50);
        document.body.style.overflow = 'hidden';
    }

    function closeImageViewer() {
        if(!viewer || !viewerImg) return;
        viewerImg.classList.remove('scale-100');
        viewerImg.classList.add('scale-95');
        setTimeout(() => {
            viewer.classList.add('opacity-0', 'invisible');
            document.body.style.overflow = '';
        }, 300);
    }

    if(closeViewerBtn) closeViewerBtn.addEventListener('click', closeImageViewer);
    if(viewer) viewer.addEventListener('click', (e) => {
        if(e.target === viewer) closeImageViewer();
    });

    document.addEventListener('DOMContentLoaded', loadCertificates);
    window.addEventListener('portfolioDataLoaded', loadCertificates);
</script>

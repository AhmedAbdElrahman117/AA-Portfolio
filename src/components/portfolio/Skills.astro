---
// Skills.astro
import SectionHeader from '../common/SectionHeader.astro';
---

<style is:global>
    /* ====================================
       Skills Section Styles (Imported from original)
       ==================================== */

    .skills-subsection {
        margin-bottom: 3rem;
    }

    .subsection-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        text-align: center;
        background: linear-gradient(135deg, #2196F3, #673AB7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Tech Stack */
    .tech-stack {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
        perspective: 1000px;
    }

    .tech-card {
        width: 125px;
        height: 125px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.05); /* --glossy-bg approx */
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        padding: 1rem;
        cursor: default;
        position: relative;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.4s ease;
        transform-style: preserve-3d;
        transform: translateZ(0);
        will-change: transform, box-shadow;
    }

    .tech-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.6s ease;
    }

    .tech-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(33, 150, 243, 0.15), transparent 60%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .tech-card:hover {
        transform: translateY(-10px) rotateX(5deg) scale(1.05);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(33, 150, 243, 0.3), inset 0 0 20px rgba(33, 150, 243, 0.1);
        border-color: #2196F3;
    }

    .tech-card:hover::before { left: 100%; }
    .tech-card:hover::after { opacity: 1; }

    .tech-card img {
        width: 50px;
        height: 50px;
        object-fit: contain;
        transition: transform 0.4s ease, filter 0.4s ease;
        filter: grayscale(0%);
        background: transparent;
        border-radius: 0;
        box-shadow: none;
        border: none;
    }

    .tech-card:hover img {
        transform: scale(1.15) rotate(5deg);
        filter: grayscale(0%) drop-shadow(0 0 8px rgba(33, 150, 243, 0.5));
    }

    /* Tech card floating animation */
    .tech-card.visible {
        animation: techCardFloat 4s ease-in-out infinite;
        /* The animation-delay is set inline via transitionDelay */
    }

    @keyframes techCardFloat {
        0%, 100% { transform: translateY(0) translateZ(0); }
        50% { transform: translateY(-8px) translateZ(0); }
    }

    .tech-card span {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        transition: color 0.3s ease, transform 0.3s ease;
    }

    .tech-card:hover span {
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* Soft Skills */
    .soft-skills {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    @media (max-width: 768px) {
        .soft-skills {
            grid-template-columns: 1fr;
        }
    }

    .skill-bar {
        width: 100%;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: default;
    }

    .skill-bar:hover {
        transform: translateX(8px);
        background: rgba(33, 150, 243, 0.1);
        border-color: #2196F3; /* --gradient-start approx */
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2), 0 0 20px rgba(33, 150, 243, 0.2), -5px 0 20px rgba(33, 150, 243, 0.3);
    }

    .skill-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .skill-bar:hover .skill-info { color: #2196F3; }

    .skill-info span:last-child {
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .skill-bar:hover .skill-info span:last-child {
        transform: scale(1.2);
        color: #2196F3;
    }

    .progress-bar {
        height: 12px;
        background: rgba(255, 255, 255, 0.1); /* --bg-secondary approx */
        border-radius: 0.25rem;
        overflow: hidden;
        position: relative;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
    }

    .skill-bar:hover .progress-bar {
        box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .progress {
        height: 100%;
        width: 0;
        background: linear-gradient(90deg, 
            var(--progress-color, #2196F3), 
            color-mix(in srgb, var(--progress-color, #2196F3) 70%, white), 
            var(--progress-color, #2196F3));
        background-size: 200% 100%;
        border-radius: 0.25rem;
        transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, height 0.3s ease;
        position: relative;
        animation: progressShimmer 2s linear infinite;
        box-shadow: 0 0 10px var(--progress-color, #2196F3);
    }

    .skill-bar:hover .progress {
        box-shadow: 0 0 20px var(--progress-color, #2196F3), 0 0 40px var(--progress-color, #2196F3);
    }

    .progress::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 50%;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), transparent);
        border-radius: 0.25rem 0.25rem 0 0;
    }

    @keyframes progressShimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* Language Skills */
    .language-skills {
        display: flex;
        justify-content: center;
        gap: 3rem;
        flex-wrap: wrap;
    }

    @media (max-width: 480px) {
        .language-skills {
            gap: 1.5rem;
        }
    }

    .language-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .circular-progress {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: conic-gradient(var(--progress-color, #2196F3) calc(var(--progress, 0) * 1%), rgba(255,255,255,0.1) 0);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        animation: circularPulse 4s ease-in-out infinite;
    }

    .circular-progress:hover {
        transform: scale(1.1);
        box-shadow: 0 0 30px var(--progress-color, #2196F3);
    }

    .circular-progress::before {
        content: '';
        position: absolute;
        width: 90px;
        height: 90px;
        background: #0f0f0f; /* main background color approx */
        border-radius: 50%;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.3);
    }

    .circular-progress::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: conic-gradient(transparent 0deg, rgba(255, 255, 255, 0.1) 90deg, transparent 180deg);
        animation: circularRotate 4s linear infinite;
    }

    @keyframes circularPulse {
        0%, 100% { box-shadow: 0 0 15px rgba(33, 150, 243, 0.3); } /* Will use JS to set color properly if possible or rely on general pulse */
        50% { box-shadow: 0 0 25px rgba(33, 150, 243, 0.5); }
    }

    @keyframes circularRotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .progress-value {
        position: relative;
        z-index: 1;
        font-size: 1.125rem;
        font-weight: 600;
        color: white;
    }

    .language-name {
        font-size: 1.125rem;
        font-weight: 500;
        color: white;
    }

    .language-level {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.7);
    }

    /* Scroll animations */
    .animate-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }

    .animate-on-scroll.visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<section id="skills" class="py-section relative bg-gradient-to-b from-black/30 to-transparent overflow-hidden">
    <div class="max-w-container mx-auto px-lg">
        <SectionHeader title="My Skills" />

        <!-- Tech Stack -->
        <div class="skills-subsection">
            <h3 class="subsection-title">Tech Stack</h3>
            <div class="tech-stack" id="tech-stack-container">
                <!-- Tech Skills Injected Here -->
            </div>
        </div>

        <!-- Soft Skills -->
        <div class="skills-subsection">
            <h3 class="subsection-title">Soft Skills</h3>
            <div class="soft-skills" id="soft-skills-container">
                <!-- Soft Skills Injected Here -->
            </div>
        </div>

        <!-- Language Skills -->
        <div class="skills-subsection">
            <h3 class="subsection-title">Languages</h3>
            <div class="language-skills" id="lang-skills-container">
                <!-- Language Skills Injected Here -->
            </div>
        </div>
    </div>
</section>

<script>
    import { getPortfolioData } from '../../lib/firebase';

    // Intersection Observer for scroll animations
    let scrollObserver: IntersectionObserver | null = null;

    function initAnimations() {
        const animatedElements = document.querySelectorAll('.animate-on-scroll');

        if (scrollObserver) {
            scrollObserver.disconnect();
        }

        scrollObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');

                    // Trigger progress bar animations if within a skills subsection
                    if (entry.target.closest('.skills-subsection')) {
                        animateProgressBars();
                        animateCircularProgress();
                    }
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });

        animatedElements.forEach(el => {
            scrollObserver!.observe(el);
        });

        initTechCardEffects();
    }

    function animateProgressBars() {
        const progressBars = document.querySelectorAll('.progress');
        progressBars.forEach((bar: any, index) => {
            const progress = bar.getAttribute('data-progress');
            setTimeout(() => {
                bar.style.width = `${progress}%`;
            }, 100 + (index * 200));
        });
    }

    function animateCircularProgress() {
        const circularProgress = document.querySelectorAll('.circular-progress');
        circularProgress.forEach((circle: any, index) => {
            const progress = circle.getAttribute('data-progress');
            setTimeout(() => {
                circle.style.setProperty('--progress', progress);
            }, 100 + (index * 300));
        });
    }

    // Tech Card Mouse Effects
    function initTechCardEffects() {
        const techCards = document.querySelectorAll('.tech-card');

        techCards.forEach((card: any) => {
            let cardRect: DOMRect | null = null;

            card.addEventListener('mouseenter', () => {
                cardRect = card.getBoundingClientRect();
            });

            card.addEventListener('mousemove', (e: MouseEvent) => {
                if (!cardRect) cardRect = card.getBoundingClientRect();

                requestAnimationFrame(() => {
                    if(!cardRect) return;
                    const x = ((e.clientX - cardRect.left) / cardRect.width) * 100;
                    const y = ((e.clientY - cardRect.top) / cardRect.height) * 100;

                    card.style.setProperty('--mouse-x', `${x}%`);
                    card.style.setProperty('--mouse-y', `${y}%`);
                });
            });

            card.addEventListener('mouseleave', () => {
                cardRect = null;
            });
        });
    }

    async function loadSkillsData() {
        const data = await getPortfolioData();
        if(!data) return;

        // 1. Tech Stack
        const techContainer = document.getElementById('tech-stack-container');
        if(techContainer && data.techSkills) {
            techContainer.innerHTML = '';
            data.techSkills.forEach((tech, index) => {
                const imageSource = tech.image.startsWith('http') ? tech.image : `/${tech.image}`;
                const div = document.createElement('div');
                div.className = `tech-card animate-on-scroll`;
                div.style.transitionDelay = `${index * 0.03}s`;
                div.setAttribute('data-name', tech.name);
                div.innerHTML = `
                    <img src="${imageSource}" alt="${tech.name}" loading="lazy" onerror="this.style.display='none'" crossorigin="anonymous">
                    <span>${tech.name}</span>
                `;
                techContainer.appendChild(div);
            });
        }

        // 2. Soft Skills
        const softContainer = document.getElementById('soft-skills-container');
        if(softContainer && data.softSkills) {
            softContainer.innerHTML = '';
            data.softSkills.forEach((skill, index) => {
                const div = document.createElement('div');
                div.className = `skill-bar animate-on-scroll`;
                div.style.transitionDelay = `${index * 0.05}s`;
                div.innerHTML = `
                    <div class="skill-info">
                        <span>${skill.name}</span>
                        <span>${skill.percentage}%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" data-progress="${skill.percentage}" style="--progress-color: ${skill.color};"></div>
                    </div>
                `;
                softContainer.appendChild(div);
            });
        }

        // 3. Language Skills
        const langContainer = document.getElementById('lang-skills-container');
        if(langContainer && data.langSkills) {
            langContainer.innerHTML = '';
            data.langSkills.forEach((skill, index) => {
                const div = document.createElement('div');
                div.className = `language-card animate-on-scroll`;
                div.style.transitionDelay = `${index * 0.1}s`;
                div.innerHTML = `
                    <div class="circular-progress" data-progress="${skill.percentage}" style="--progress-color: ${skill.color};">
                        <div class="progress-value">${skill.percentage}%</div>
                    </div>
                    <span class="language-name">${skill.name}</span>
                    <span class="language-level">${skill.level}</span>
                `;
                langContainer.appendChild(div);
            });
        }

        // Re-initialize animations after DOM update
        setTimeout(initAnimations, 100);
    }

    document.addEventListener('DOMContentLoaded', loadSkillsData);
    window.addEventListener('portfolioDataLoaded', loadSkillsData);
</script>

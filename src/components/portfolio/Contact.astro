---
// Contact.astro
import SectionHeader from "../common/SectionHeader.astro";
---

<section
    id="contact"
    class="py-section relative bg-gradient-to-b from-black/30 to-transparent overflow-hidden"
    style="content-visibility: auto; contain-intrinsic-size: auto 800px;"
>
    <div class="max-w-container mx-auto px-lg">
        <SectionHeader title="Contact Me" />

        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-2xl mt-xl">
            <!-- Left: Info -->
            <div
                class="flex flex-col gap-xl opacity-0 translate-y-8 transition-all duration-700 animate-slide-left"
            >
                <div class="flex flex-col gap-lg" id="contact-info-blocks">
                    <!-- Dynamic Info Blocks -->
                    <h3 class="text-2xl font-bold gradient-text mb-2">
                        Get In Touch
                    </h3>
                    <div class="flex items-start gap-md group">
                        <div
                            class="w-12 h-12 rounded-full flex items-center justify-center bg-white/5 border border-border text-brand-light text-xl transition-all duration-300 group-hover:bg-brand-light group-hover:text-white group-hover:shadow-[0_0_15px_rgba(33,150,243,0.5)] group-hover:-translate-y-1"
                        >
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <div class="flex flex-col justify-center h-12">
                            <h4
                                class="text-base font-bold text-text-primary m-0"
                            >
                                Location
                            </h4>
                            <p
                                class="text-sm text-text-muted m-0"
                                id="contact-address"
                            >
                                Loading...
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-md group">
                        <div
                            class="w-12 h-12 rounded-full flex items-center justify-center bg-white/5 border border-border text-brand-light text-xl transition-all duration-300 group-hover:bg-brand-light group-hover:text-white group-hover:shadow-[0_0_15px_rgba(33,150,243,0.5)] group-hover:-translate-y-1"
                        >
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="flex flex-col justify-center h-12">
                            <h4
                                class="text-base font-bold text-text-primary m-0"
                            >
                                Phone
                            </h4>
                            <a
                                href="#"
                                class="text-sm text-text-muted hover:text-brand-light transition-colors"
                                id="contact-phone">Loading...</a
                            >
                        </div>
                    </div>

                    <div class="flex items-start gap-md group">
                        <div
                            class="w-12 h-12 rounded-full flex items-center justify-center bg-white/5 border border-border text-brand-accent text-xl transition-all duration-300 group-hover:bg-brand-accent group-hover:text-white group-hover:shadow-[0_0_15px_rgba(233,30,99,0.5)] group-hover:-translate-y-1"
                        >
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="flex flex-col justify-center h-12">
                            <h4
                                class="text-base font-bold text-text-primary m-0"
                            >
                                Email
                            </h4>
                            <a
                                href="#"
                                class="text-sm text-text-muted hover:text-brand-accent transition-colors"
                                id="contact-email">Loading...</a
                            >
                        </div>
                    </div>
                </div>

                <div class="mt-lg">
                    <h4 class="text-xl font-bold text-text-primary mb-md">
                        Follow Me
                    </h4>
                    <div class="flex gap-md contact-social-links">
                        <!-- Loaded dynamically matching original icon logic -->
                    </div>
                </div>
            </div>

            <!-- Right: Form -->
            <div
                class="glass-effect p-xl rounded-2xl opacity-0 translate-y-8 transition-all duration-700 delay-200 animate-slide-right"
            >
                <form
                    id="publicContactForm"
                    class="flex flex-col gap-lg"
                    aria-label="Contact form"
                >
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 gap-lg relative z-0"
                    >
                        <div class="relative">
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                autocomplete="name"
                                class="w-full bg-transparent border-b border-white/20 px-0 py-sm text-text-primary text-base transition-colors focus:outline-none focus:border-brand-light peer placeholder-transparent"
                                placeholder="Name"
                            />
                            <label
                                for="name"
                                class="absolute left-0 top-sm text-text-muted text-base transition-all peer-focus:-top-5 peer-focus:text-xs peer-focus:text-brand-light peer-valid:-top-5 peer-valid:text-xs"
                                >Your Name</label
                            >
                            <span
                                class="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-brand-light to-brand-dark transition-all duration-300 peer-focus:w-full"
                            ></span>
                        </div>
                        <div class="relative">
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                autocomplete="email"
                                class="w-full bg-transparent border-b border-white/20 px-0 py-sm text-text-primary text-base transition-colors focus:outline-none focus:border-brand-light peer placeholder-transparent"
                                placeholder="Email"
                            />
                            <label
                                for="email"
                                class="absolute left-0 top-sm text-text-muted text-base transition-all peer-focus:-top-5 peer-focus:text-xs peer-focus:text-brand-light peer-valid:-top-5 peer-valid:text-xs"
                                >Your Email</label
                            >
                            <span
                                class="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-brand-light to-brand-dark transition-all duration-300 peer-focus:w-full"
                            ></span>
                        </div>
                    </div>
                    <div class="relative">
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            required
                            class="w-full bg-transparent border-b border-white/20 px-0 py-sm text-text-primary text-base transition-colors focus:outline-none focus:border-brand-light peer placeholder-transparent"
                            placeholder="Subject"
                        />
                        <label
                            for="subject"
                            class="absolute left-0 top-sm text-text-muted text-base transition-all peer-focus:-top-5 peer-focus:text-xs peer-focus:text-brand-light peer-valid:-top-5 peer-valid:text-xs"
                            >Subject</label
                        >
                        <span
                            class="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-brand-light to-brand-dark transition-all duration-300 peer-focus:w-full"
                        ></span>
                    </div>
                    <div class="relative mt-2">
                        <textarea
                            id="message"
                            name="message"
                            required
                            rows="5"
                            class="w-full bg-transparent border-b border-white/20 px-0 py-sm text-text-primary text-base transition-colors focus:outline-none focus:border-brand-light peer placeholder-transparent resize-y min-h-[100px]"
                            placeholder="Message"></textarea>
                        <label
                            for="message"
                            class="absolute left-0 top-sm text-text-muted text-base transition-all peer-focus:-top-5 peer-focus:text-xs peer-focus:text-brand-light peer-valid:-top-5 peer-valid:text-xs"
                            >Message</label
                        >
                        <span
                            class="absolute bottom-0 left-0 w-0 h-[2px] bg-gradient-to-r from-brand-light to-brand-dark transition-all duration-300 peer-focus:w-full"
                        ></span>
                    </div>
                    <button
                        type="submit"
                        class="self-start mt-md relative overflow-hidden border-none text-white font-medium cursor-pointer rounded-full transition-all duration-300 py-3 px-8 text-sm bg-gradient-to-r from-brand-light to-brand-dark shadow-md hover:-translate-y-[2px] hover:shadow-glow group"
                    >
                        <span class="relative z-10 flex items-center gap-2"
                            ><i class="fas fa-paper-plane text-xs"></i> Send Message</span
                        >
                        <div
                            class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.3),transparent_60%)] opacity-0 group-hover:opacity-100 transition-opacity duration-400 rounded-full"
                        >
                        </div>
                    </button>
                    <!-- Form Status -->
                    <div
                        id="formStatus"
                        class="mt-4 text-sm hidden px-4 py-2 rounded-lg text-center"
                    >
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    import { getPortfolioData } from "../../lib/firebase";

    async function loadContact() {
        const data = await getPortfolioData();
        if (!data || !data.contact) return;

        const addr = document.getElementById("contact-address");
        const phone = document.getElementById("contact-phone");
        const email = document.getElementById("contact-email");

        if (addr) addr.textContent = data.contact.address || "";
        if (phone) {
            phone.textContent = data.contact.phone || "";
            phone.setAttribute("href", `tel:${data.contact.phone}`);
        }
        if (email) {
            email.textContent = data.contact.email || "";
            email.setAttribute("href", `mailto:${data.contact.email}`);
        }

        // Social Links duplication from original
        const socialContainer = document.querySelector(".contact-social-links");
        if (socialContainer && data.social) {
            socialContainer.innerHTML = "";
            const linksMap: Record<string, { icon: string; color: string }> = {
                linkedin: { icon: "fa-linkedin-in", color: "#0A66C2" },
                github: { icon: "fa-github", color: "#ffffff" },
                facebook: { icon: "fa-facebook-f", color: "#1877F2" },
                whatsapp: { icon: "fa-whatsapp", color: "#25D366" },
                instagram: { icon: "fa-instagram", color: "#E4405F" },
            };

            for (const [key, value] of Object.entries(data.social)) {
                if (value && value !== "#" && linksMap[key]) {
                    const mapData = linksMap[key];
                    const a = document.createElement("a");
                    a.href = value.toString();
                    a.target = "_blank";
                    a.rel = "noopener noreferrer";
                    a.className =
                        "w-10 h-10 rounded-full flex items-center justify-center bg-white/5 border border-border text-text-primary text-sm transition-all duration-300 hover:-translate-y-1 hover:bg-[var(--hover-color)] hover:border-transparent hover:shadow-[0_5px_15px_var(--shadow-color)] group";
                    a.style.setProperty("--hover-color", mapData.color);

                    // Convert hex to rgba for shadow
                    let hex = mapData.color.replace("#", "");
                    if (hex.length === 3)
                        hex =
                            hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
                    const r = parseInt(hex.substring(0, 2), 16),
                        g = parseInt(hex.substring(2, 4), 16),
                        b = parseInt(hex.substring(4, 6), 16);
                    a.style.setProperty(
                        "--shadow-color",
                        `rgba(${r},${g},${b},0.4)`,
                    );

                    a.setAttribute(
                        "aria-label",
                        key.charAt(0).toUpperCase() + key.slice(1),
                    );
                    a.innerHTML = `<i class="fab ${mapData.icon} transition-transform duration-300 group-hover:scale-110" aria-hidden="true"></i>`;
                    socialContainer.appendChild(a);
                }
            }
        }
    }

    // Form Handling
    const contactForm = document.getElementById(
        "publicContactForm",
    ) as HTMLFormElement;
    const formStatus = document.getElementById("formStatus");

    if (contactForm && formStatus) {
        contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = contactForm.querySelector('button[type="submit"]');
            const originalBtnText = btn ? btn.innerHTML : "";

            if (btn)
                btn.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Sending...';
            contactForm.classList.add("opacity-50", "pointer-events-none");

            try {
                // Here you would normally integrate with an API like EmailJS or Firebase Functions
                // Since original site didn't seem to have a concrete backend endpoint directly in JS for form emails, we simulate a success
                await new Promise((resolve) => setTimeout(resolve, 1500));

                formStatus.textContent =
                    "Thank you! Your message has been sent successfully.";
                formStatus.className =
                    "mt-4 text-sm px-4 py-2 rounded-lg text-center bg-green-500/20 text-green-400 border border-green-500/30 font-medium block";
                contactForm.reset();
            } catch (error) {
                formStatus.textContent =
                    "Oops! Something went wrong. Please try again later.";
                formStatus.className =
                    "mt-4 text-sm px-4 py-2 rounded-lg text-center bg-red-500/20 text-red-400 border border-red-500/30 font-medium block";
            } finally {
                contactForm.classList.remove(
                    "opacity-50",
                    "pointer-events-none",
                );
                if (btn) btn.innerHTML = originalBtnText;
                setTimeout(() => {
                    formStatus.classList.add("hidden");
                }, 5000);
            }
        });
    }

    // View Observer
    document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.remove(
                            "opacity-0",
                            "translate-y-8",
                        );
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.1 },
        );

        document
            .querySelectorAll(".animate-slide-left, .animate-slide-right")
            .forEach((card) => observer.observe(card));

        loadContact();
    });
    window.addEventListener("portfolioDataLoaded", loadContact);
</script>
